{
  "name": "autobrowser",
  "productName": "AutoBrowser",
  "version": "0.4.0",
  "description": "Record-and-replay browser automation with optional AI",
  "main": "src/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env AB_DEV=1 electron .",
    "check": "node --check src/main.js && node --check src/runner.js && node --check src/human.js && node --check src/backend.js && node --check src/stealth.js && node --check src/preload-ui.js && node --check src/preload-page.js && node --check src/firefox.js && node --check src/template.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "test:e2e": "node test/e2e.js",
    "test:e2e:firefox": "node test/e2e-firefox.js",
    "test:unit": "node --test test/unit/*.test.js"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "app.autobrowser.desktop",
    "productName": "AutoBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "app-ui"
      },
      {
        "from": "../backend/dist/autobrowser-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "AutoBrowser-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ]
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  }
}
